@model StudentBudgetApp.Models.BudgetEntry

@{
    ViewData["Title"] = "Delete Transaction";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-sm border-0 overflow-hidden">
                <div class="card-header bg-danger-subtle text-danger border-bottom p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon-wrapper bg-white text-danger shadow-xs" style="width: 48px; height: 48px;">
                            <i class="bi bi-trash3-fill fs-4"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0">Confirm Deletion</h4>
                            <p class="text-danger small mb-0 opacity-75">This action cannot be undone.</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <p class="text-muted small mb-3">Are you sure you want to remove this transaction record from your budget logs?</p>

                    <div class="bg-light p-3 rounded-3 mb-4 border">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Description</span>
                            <span class="fw-bold text-dark">@Model.Title</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Category</span>
                            <span class="badge-pill-soft badge-category small">@Model.Category</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Type</span>
                            <span class="badge-pill-soft @(Model.Type == "Income" ? "badge-income" : "badge-expense") small">@Model.Type</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Date</span>
                            <span class="text-muted small">@Model.Date.ToString("MMM dd, yyyy")</span>
                        </div>
                        <hr class="my-2 border-secondary-subtle">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-semibold text-dark">Amount</span>
                            <span class="fs-5 fw-bold @(Model.Type == "Income" ? "text-success" : "text-danger")">
                                ₹@Model.Amount.ToString("N2")
                            </span>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger py-2 rounded-pill shadow-sm d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-trash3"></i>
                                <span>Yes, Delete Transaction</span>
                            </button>
                            <a asp-action="Index" class="btn btn-light py-2 rounded-pill text-muted border">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>