@model StudentBudgetApp.Models.BudgetEntry

@{
    ViewData["Title"] = "Edit Transaction";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm border-0 overflow-hidden">
                <div class="card-header bg-white border-bottom p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon-wrapper bg-warning-subtle text-warning" style="width: 48px; height: 48px;">
                            <i class="bi bi-pencil-square fs-4"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0 text-dark">Edit Transaction</h4>
                            <p class="text-muted small mb-0">Update details for transaction #@Model.Id</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <!-- Type Selector (Income vs Expense) -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted text-uppercase">Transaction Type</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="radio" class="btn-check" name="Type" id="typeExpense" value="Expense" checked="@(Model.Type == "Expense")">
                                    <label class="btn btn-outline-danger w-100 py-2 d-flex align-items-center justify-content-center gap-2 rounded-3" for="typeExpense">
                                        <i class="bi bi-arrow-up-right-circle"></i>
                                        <span>Expense</span>
                                    </label>
                                </div>
                                <div class="col-6">
                                    <input type="radio" class="btn-check" name="Type" id="typeIncome" value="Income" checked="@(Model.Type == "Income")">
                                    <label class="btn btn-outline-success w-100 py-2 d-flex align-items-center justify-content-center gap-2 rounded-3" for="typeIncome">
                                        <i class="bi bi-arrow-down-left-circle"></i>
                                        <span>Income</span>
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="Type" class="text-danger small"></span>
                        </div>

                        <!-- Title -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold small text-muted text-uppercase">Description / Title</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-fonts"></i></span>
                                <input asp-for="Title" class="form-control" placeholder="e.g., Campus Cafeteria, Semester Book" />
                            </div>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Amount -->
                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label fw-semibold small text-muted text-uppercase">Amount (₹)</label>
                            <div class="input-group">
                                <span class="input-group-text fw-bold">₹</span>
                                <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <!-- Category -->
                        <div class="mb-3">
                            <label asp-for="Category" class="form-label fw-semibold small text-muted text-uppercase">Category</label>
                            <div class="input-group mb-2">
                                <span class="input-group-text"><i class="bi bi-tag-fill"></i></span>
                                <input asp-for="Category" id="categoryInput" class="form-control" placeholder="Select a chip below or type..." />
                            </div>
                            <!-- Quick Student Category Chips -->
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                <span class="category-chip" onclick="selectCategory('Food')">🍔 Food</span>
                                <span class="category-chip" onclick="selectCategory('Rent')">🏠 Rent</span>
                                <span class="category-chip" onclick="selectCategory('Books')">📚 Books</span>
                                <span class="category-chip" onclick="selectCategory('Tuition')">🎓 Tuition</span>
                                <span class="category-chip" onclick="selectCategory('Transit')">🚌 Transit</span>
                                <span class="category-chip" onclick="selectCategory('Coffee')">☕ Coffee</span>
                                <span class="category-chip" onclick="selectCategory('Allowance')">💵 Allowance</span>
                                <span class="category-chip" onclick="selectCategory('Job')">💼 Part-time</span>
                            </div>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>

                        <!-- Date -->
                        <div class="mb-4">
                            <label asp-for="Date" class="form-label fw-semibold small text-muted text-uppercase">Date</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                                <input asp-for="Date" class="form-control" type="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
                            </div>
                            <span asp-validation-for="Date" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary py-2 rounded-pill shadow-sm d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Save Changes</span>
                            </button>
                            <a asp-action="Index" class="btn btn-light py-2 rounded-pill text-muted border">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function selectCategory(category) {
            const input = document.getElementById('categoryInput');
            if (input) {
                input.value = category;
                input.focus();
            }
        }
    </script>
}